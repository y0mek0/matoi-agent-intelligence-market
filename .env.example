# ============================================================
# Agent Intelligence Market — environment template
# Copy this file to `.env.local` (local dev) and fill values.
# NEVER commit .env.local / .env to git.
# ============================================================

# ---------- App ----------
NEXT_PUBLIC_APP_NAME=Agent Intelligence Market
NEXT_PUBLIC_DEMO_MODE=true

# ---------- Hedera testnet (primary operator: ED25519 account) ----------
HEDERA_NETWORK=testnet
# Account ID looks like 0.0.XXXXXXX
HEDERA_OPERATOR_ID=
# Private key for the ED25519 account (paste exactly as shown in portal)
HEDERA_OPERATOR_KEY=

# ---------- Hedera testnet (ECDSA payer account, has EVM address) ----------
# Used for x402 / Blocky402 USDC transfers on Hedera testnet.
HEDERA_ECDSA_ACCOUNT_ID=
# HEX private key (starts with 0x…) OR DER-encoded private key
HEDERA_ECDSA_KEY=
HEDERA_ECDSA_EVM_ADDRESS=

# Legacy alias used by /api/x402/blocky402/pay. Use either this pair or the
# ECDSA pair above; both map to the same Hedera testnet payer.
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PAYER_KEY=

# HCS topic used for public audit proofs (hashes only, no raw messages/secrets)
HEDERA_HCS_TOPIC_ID=
HEDERA_HCS_SIGNER=
HEDERA_HCS_KEY_FORMAT=

# Hedera testnet USDC token id (default 0.0.429274). Account must be associated.
HEDERA_TESTNET_USDC_TOKEN_ID=0.0.429274

# ---------- Arc / Circle (testnet) ----------
# ARC_NETWORK=testnet
# ARC_WALLET_ID=
# CIRCLE_API_KEY=
# ARC_USDC_CONTRACT=

# ---------- Telegram (own group/channel with bot) ----------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# TELEGRAM_WEBHOOK_SECRET=

# ---------- OpenRouter (only needed later for free-text analysis) ----------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- Public URL (cloudflared tunnel or deployment) ----------
# Used by scripts/setup-telegram-webhook.py to register Telegram webhook.
# Example for cloudflared anonymous tunnel: https://xxxx.trycloudflare.com
# PUBLIC_URL=

# ---------- Blocky402 / x402 facilitator (Hedera testnet paid requests) ----------
# Hedera testnet facilitator used for x402 paid provider calls.
# Self-hosted Blocky402-compatible shim lives at /api/x402/blocky402-facilitator.
# BLOCKY402_URL=http://127.0.0.1:3100/api/x402/blocky402-facilitator
#
# Provide either HEDERA_PAYER_ACCOUNT_ID+HEDERA_PAYER_KEY OR the legacy
# HEDERA_OPERATOR_ID+HEDERA_OPERATOR_KEY pair.

# ---------- Local toggles ----------
# Toggle real ARC-TESTNET USDC transfer path (default false). Requires both flags.
ARC_REAL_USDC_TRANSFER=false
CONFIRM_REAL_TRANSFER=false
# Force mainnet disabled flag on the response contract (default true).
NEXT_PUBLIC_MAINNET_DISABLED=true
