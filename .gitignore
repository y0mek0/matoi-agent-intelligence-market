# Env files (can opt-in for committing if needed)
.env*
!.env.example

# Local runtime data
/.data/
/test-results/
/playwright-report/

# Circle recovery files / wallet secrets
/recovery/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

